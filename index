<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raffy & Luis — 19 de mayo, 2028</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@400;500&display=swap" rel="stylesheet">
<style>

:root{
  --sage:#A8C08A; --sage-dark:#4E6A38; --sage-deep:#33461F;
  --rose:#E8CFD4; --rose-dark:#8A5B63;
  --ivory:#FAF7F0; --gold:#C9B896; --gold-dark:#7A6A45; --ink:#2F3A28;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--ivory); color:var(--ink); font-family:'EB Garamond', serif; overflow-x:hidden;}
.reveal{opacity:0; transform:translateY(18px); transition:opacity 1s ease, transform 1s ease;}
.reveal.in{opacity:1; transform:translateY(0);}
.eyebrow{font-family:'Jost', sans-serif; font-size:12px; letter-spacing:0.28em; text-transform:uppercase; color:var(--sage-dark);}
.divider{display:flex; align-items:center; justify-content:center; gap:14px; margin:22px 0;}
.divider .line{width:44px; height:1px; background:var(--gold);}
section{padding:10vh 6vw;}
h2.section-title{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(30px,5vw,42px); color:var(--sage-dark); text-align:center; margin:6px 0 44px;}

/* TOPNAV */
.util-bar{background:var(--ivory); border-bottom:0.5px solid rgba(0,0,0,0.06); display:flex; justify-content:center; gap:22px; padding:7px 6vw; flex-wrap:wrap;}
.util-bar a{display:flex; align-items:center; gap:6px; color:var(--gold-dark); font-family:'Jost', sans-serif; font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; text-decoration:none; opacity:0.8; transition:opacity 0.2s ease, color 0.2s ease;}
.util-bar a:hover{opacity:1; color:var(--sage-dark);}
.util-bar svg{width:14px; height:14px; flex-shrink:0;}
@media (max-width:480px){ .util-bar a span{display:none;} }
.topnav{
  position:sticky; top:0; z-index:30; background:rgba(250,247,240,0.92); backdrop-filter:blur(6px);
  border-bottom:0.5px solid rgba(0,0,0,0.08);
  display:flex; align-items:center; justify-content:space-between; padding:16px 6vw;
}
.topnav .logo{font-family:'Cormorant Garamond', serif; font-size:20px; font-style:italic; color:var(--sage-dark); text-decoration:none;}
.topnav .navlinks{display:flex; align-items:center; gap:26px;}
.topnav a{font-family:'Jost', sans-serif; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink); text-decoration:none; opacity:0.8;}
.topnav a:hover{opacity:1; color:var(--sage-dark);}
.topnav a.cta{background:var(--sage-dark); color:var(--ivory); padding:9px 18px; border-radius:2px; opacity:1;}
.topnav a.cta:hover{background:var(--sage-deep);}
@media (max-width:600px){ .topnav{flex-direction:column; gap:12px;} .topnav .navlinks{gap:16px; flex-wrap:wrap; justify-content:center;} }

/* PAGE HERO (subpages) */
.page-hero{text-align:center; padding:9vh 6vw 4vh;}
.page-hero h1{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(36px,7vw,58px); color:var(--sage-dark); margin:8px 0 4px;}
.page-hero p{font-size:16px; max-width:480px; margin:14px auto 0; line-height:1.6;}

/* HERO (home) */
.hero{position:relative; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:6vh 6vw 6vh; background:radial-gradient(circle at 20% 15%, rgba(168,192,138,0.25), transparent 45%), radial-gradient(circle at 85% 80%, rgba(232,207,212,0.35), transparent 45%), var(--ivory);}
.vine{position:absolute; opacity:0.5; pointer-events:none;}
.vine.tl{top:0; left:0; width:200px;}
.vine.br{bottom:0; right:0; width:200px; transform:rotate(180deg);}
.heart-frame{width:220px; height:220px; position:relative; margin-bottom:22px;}
.heart-frame svg{width:100%; height:100%;}
.heart-frame .label{position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-family:'Cormorant Garamond', serif; font-style:italic; font-size:15px; color:var(--sage-deep); width:120px; line-height:1.4;}
.hero-names{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(44px, 8.5vw, 90px); line-height:1.05; color:var(--sage-dark); margin:6px 0 4px;}
.hero-amp{font-style:italic; color:var(--rose-dark); font-size:0.7em; padding:0 12px;}
.hero-date{font-family:'Jost', sans-serif; font-size:14px; letter-spacing:0.18em; text-transform:uppercase; color:var(--gold-dark);}
.countdown{display:flex; gap:10px; margin-top:36px; flex-wrap:wrap; justify-content:center;}
.countdown .unit{background:#fff; border:0.5px solid rgba(0,0,0,0.08); padding:16px 20px; min-width:78px; text-align:center; border-radius:4px;}
.countdown .num{font-family:'Cormorant Garamond', serif; font-weight:600; font-size:32px; color:var(--sage-deep); display:block;}
.countdown .lbl{font-family:'Jost', sans-serif; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--gold-dark);}

/* COUPLE */
.couple{max-width:760px; margin:0 auto; text-align:center;}
.couple-row{display:flex; align-items:center; justify-content:center; gap:56px; flex-wrap:wrap;}
.person{max-width:220px;}
.avatar{width:120px; height:120px; border-radius:50%; margin:0 auto 16px; display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond', serif; font-size:38px; color:#fff; border:3px solid var(--gold);}
.avatar.her{background:var(--rose-dark);}
.avatar.him{background:var(--sage-dark);}
.person h3{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:22px; color:var(--sage-deep); margin-bottom:6px;}
.person p{font-size:15px; opacity:0.85; line-height:1.5;}
.heart-icon{color:var(--rose-dark);}

/* TIMELINE */
.timeline{max-width:680px; margin:0 auto;}
.tl-item{display:grid; grid-template-columns:70px 1fr; gap:20px; position:relative; padding-bottom:44px;}
.tl-item:last-child{padding-bottom:0;}
.tl-item::before{content:''; position:absolute; left:34px; top:44px; bottom:0; width:1px; background:var(--gold);}
.tl-item:last-child::before{display:none;}
.tl-dot{width:70px; height:70px; border-radius:50%; background:#fff; border:1px solid var(--gold); display:flex; align-items:center; justify-content:center; font-family:'Cormorant Garamond', serif; font-size:15px; color:var(--sage-deep); text-align:center; line-height:1.1;}
.tl-body h3{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:22px; color:var(--sage-deep); margin-bottom:6px;}
.tl-body p{font-size:16px; line-height:1.6;}

/* GALLERY */
.gallery{display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; max-width:900px; margin:0 auto;}
@media (max-width:640px){ .gallery{grid-template-columns:repeat(2,1fr);} }
.gallery .tile{aspect-ratio:1; border-radius:4px; display:flex; align-items:center; justify-content:center; color:#fff;}
.gallery svg{width:26px; height:26px; opacity:0.85;}
.tile.c1{background:linear-gradient(140deg,var(--sage),var(--sage-dark));}
.tile.c2{background:linear-gradient(140deg,var(--rose),var(--rose-dark));}
.tile.c3{background:linear-gradient(140deg,var(--gold),var(--gold-dark));}
.tile.c4{background:linear-gradient(140deg,var(--sage-dark),var(--sage-deep));}
.tile.c5{background:linear-gradient(140deg,var(--rose-dark),#5c2c36);}
.tile.c6{background:linear-gradient(140deg,var(--gold-dark),#4a3f26);}
.gallery-note{text-align:center; font-size:14px; color:var(--gold-dark); font-style:italic; margin-top:16px;}

/* STORY (texture band) */
.story{position:relative; background:var(--sage-deep); color:var(--ivory); text-align:center; overflow:hidden;}
.story::before{content:''; position:absolute; inset:0; opacity:0.15; background-image:radial-gradient(circle at 10% 20%, var(--sage) 0, transparent 3%),radial-gradient(circle at 80% 10%, var(--sage) 0, transparent 3%),radial-gradient(circle at 30% 80%, var(--gold) 0, transparent 3%),radial-gradient(circle at 90% 70%, var(--rose) 0, transparent 3%),radial-gradient(circle at 60% 40%, var(--sage) 0, transparent 3%); background-size:340px 340px;}
.story-inner{position:relative; max-width:600px; margin:0 auto;}
.story .eyebrow{color:var(--rose);}
.story h2{font-family:'Cormorant Garamond', serif; font-weight:400; font-size:clamp(30px,5vw,42px); margin:12px 0 20px;}
.story p{font-size:17px; line-height:1.75; color:#E4EAD9; margin-bottom:28px;}
.btn-outline{display:inline-block; font-family:'Jost', sans-serif; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ivory); border:1px solid rgba(250,247,240,0.5); padding:14px 30px; border-radius:2px; text-decoration:none; transition:background 0.2s ease, border-color 0.2s ease;}
.btn-outline:hover{background:rgba(250,247,240,0.1); border-color:var(--ivory);}

/* DETAILS cards */
.details{max-width:920px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:32px;}
@media (max-width:640px){ .details{grid-template-columns:1fr;} .couple-row{gap:32px;} .stay-wrap{grid-template-columns:1fr;} }
.card{background:#fff; border:0.5px solid rgba(0,0,0,0.08); border-radius:4px; overflow:hidden; text-align:left;}
.card-visual{height:150px; display:flex; align-items:center; justify-content:center;}
.card-visual.a{background:linear-gradient(135deg, var(--sage) 0%, var(--sage-dark) 100%);}
.card-visual.b{background:linear-gradient(135deg, var(--rose) 0%, var(--rose-dark) 100%);}
.card-visual svg{width:34px; height:34px; color:#fff;}
.card-body{padding:28px 30px;}
.card h3{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:24px; color:var(--sage-deep); margin-bottom:8px;}
.card p{font-size:16px; line-height:1.6;}
.card .place{color:var(--rose-dark); font-style:italic; margin-top:4px;}

/* MAP */
.map-wrap{max-width:900px; margin:0 auto; text-align:center;}
.map-box{height:260px; border-radius:4px; background:linear-gradient(0deg, rgba(0,0,0,0.03) 1px, transparent 1px) 0 0/28px 28px, linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px) 0 0/28px 28px, var(--sage); position:relative; display:flex; align-items:center; justify-content:center; margin-bottom:20px;}
.map-box svg{width:36px; height:36px; color:var(--sage-deep);}
.btn-solid{display:inline-block; font-family:'Jost', sans-serif; font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ivory); background:var(--sage-dark); padding:14px 30px; border-radius:2px; text-decoration:none; transition:background 0.2s ease;}
.btn-solid:hover{background:var(--sage-deep);}

/* DRESS CODE */
.dress-wrap{max-width:640px; margin:0 auto; text-align:center;}
.dress-wrap p.desc{font-size:16px; line-height:1.7; margin-bottom:26px;}
.swatches{display:flex; justify-content:center; gap:10px; margin-bottom:10px;}
.swatches span{width:38px; height:38px; border-radius:50%; border:2px solid #fff; box-shadow:0 0 0 1px rgba(0,0,0,0.08);}
.swatch-note{font-size:13px; color:var(--gold-dark); font-style:italic;}
.avoid-note{font-size:14px; margin-top:18px; color:var(--rose-dark);}

/* MENU */
.menu-wrap{max-width:560px; margin:0 auto;}
.menu-block{margin-bottom:32px; text-align:center;}
.menu-block h3{font-family:'Jost', sans-serif; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold-dark); margin-bottom:12px;}
.menu-block p{font-family:'Cormorant Garamond', serif; font-size:22px; color:var(--sage-deep); line-height:1.5;}
.menu-note{text-align:center; font-size:14px; margin-top:8px; opacity:0.8;}

/* GIFTS */
.gifts-wrap{max-width:560px; margin:0 auto; text-align:center;}
.gifts-wrap svg{width:36px; height:36px; color:var(--sage-dark); margin-bottom:16px;}
.gifts-wrap p{font-size:16px; line-height:1.7; margin-bottom:24px;}

/* ACCOMMODATION */
.stay-wrap{max-width:900px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:28px;}
.stay-card{background:#fff; border:0.5px solid rgba(0,0,0,0.08); border-radius:4px; padding:28px 30px; text-align:left;}
.stay-card h3{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:22px; color:var(--sage-deep); margin-bottom:6px;}
.stay-card p{font-size:15px; line-height:1.6;}
.stay-card .tag{display:inline-block; font-family:'Jost', sans-serif; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; background:var(--rose); color:#5c2c36; padding:4px 10px; border-radius:2px; margin-top:10px;}

/* RSVP */
.rsvp{background:var(--ivory); text-align:center;}
form{max-width:420px; margin:0 auto; display:flex; flex-direction:column; gap:14px;}
form input, form select{font-family:'EB Garamond', serif; font-size:16px; padding:12px 16px; border-radius:2px; border:1px solid rgba(0,0,0,0.18); background:#fff; color:var(--ink);}
form input:focus, form select:focus{outline:none; border-color:var(--rose-dark);}
.rsvp p.lead{font-size:16px; max-width:440px; margin:0 auto 32px;}
button{font-family:'Jost', sans-serif; font-size:13px; letter-spacing:0.18em; text-transform:uppercase; background:var(--sage-dark); color:var(--ivory); border:none; padding:15px 20px; border-radius:2px; cursor:pointer; transition:transform 0.2s ease, background 0.2s ease;}
button:hover{background:var(--sage-deep);}
button:active{transform:scale(0.98);}

/* Cross-page link cards (home) */
.linkcards{max-width:900px; margin:0 auto; display:grid; grid-template-columns:repeat(3,1fr); gap:24px;}
@media (max-width:640px){ .linkcards{grid-template-columns:1fr;} }
.linkcard{background:#fff; border:0.5px solid rgba(0,0,0,0.08); border-radius:4px; padding:32px 26px; text-align:center; text-decoration:none; color:var(--ink); transition:border-color 0.2s ease, transform 0.2s ease;}
.linkcard:hover{border-color:var(--sage-dark); transform:translateY(-3px);}
.linkcard svg{width:28px; height:28px; color:var(--sage-dark); margin-bottom:14px;}
.linkcard h3{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:22px; color:var(--sage-deep); margin-bottom:6px;}
.linkcard p{font-size:14px; opacity:0.8;}

.countdown-band{background:var(--sage-deep); color:var(--ivory); text-align:center; padding:7vh 6vw;}
.countdown-big{display:flex; justify-content:center; gap:28px; flex-wrap:wrap; margin-top:10px;}
.countdown-big .unit{min-width:90px;}
.countdown-big .num{font-family:'Cormorant Garamond', serif; font-weight:600; font-size:52px; color:var(--ivory); display:block; line-height:1;}
.countdown-big .lbl{font-family:'Jost', sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--rose);}
.name-label{font-family:'Jost', sans-serif; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold-dark); display:block; margin-bottom:10px;}
.closing-band{background:var(--gold-dark); color:var(--ivory); text-align:center; padding:10vh 6vw;}
.closing-band h2{font-family:'Cormorant Garamond', serif; font-weight:400; font-size:clamp(28px,5vw,40px); line-height:1.3; max-width:620px; margin:0 auto;}
footer{text-align:center; padding:8vh 6vw; font-family:'Cormorant Garamond', serif; font-style:italic; font-size:20px; color:var(--gold-dark); background:var(--ivory); border-top:0.5px solid rgba(0,0,0,0.08);}
footer span{display:block; font-size:13px; font-family:'Jost', sans-serif; letter-spacing:0.14em; text-transform:uppercase; color:var(--sage-dark); margin-top:10px; font-style:normal;}


.split-hero{display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:48px; max-width:1180px; margin:0 auto; padding:16vh 6vw 10vh;}
@media (max-width:820px){ .split-hero{grid-template-columns:1fr; text-align:center; padding-top:12vh;} }
.split-hero h1{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(38px,6vw,62px); line-height:1.08; color:var(--sage-dark); margin:10px 0 18px;}
.split-hero p.lead{font-size:16px; line-height:1.75; max-width:420px; margin-bottom:26px;}
@media (max-width:820px){ .split-hero p.lead{margin-left:auto; margin-right:auto;} }
.photo-wrap{position:relative;}
.photo-wrap img{width:100%; aspect-ratio:3/4; object-fit:cover; border-radius:200px 200px 24px 24px; display:block;}
.photo-wrap .vine{position:absolute; width:130px; opacity:0.65;}
.photo-wrap .vine.pw-tl{top:-30px; left:-30px;}
.photo-wrap .vine.pw-br{bottom:-30px; right:-30px; transform:rotate(180deg);}

.block-row{display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; max-width:1080px; margin:0 auto; padding:9vh 6vw;}
@media (max-width:760px){ .block-row{grid-template-columns:1fr; padding:6vh 6vw;} }
.block-row.reverse{grid-template-columns:1fr 1fr;}
.block-row.reverse .block-photo{order:2;}
.block-row.reverse .block-copy{order:1;}
@media (max-width:760px){ .block-row.reverse .block-photo, .block-row.reverse .block-copy{order:initial;} }
.block-photo{position:relative;}
.block-photo img.main{width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:6px; display:block;}
.block-photo img.accent{position:absolute; width:46%; aspect-ratio:1; object-fit:cover; border-radius:6px; border:6px solid var(--ivory); bottom:-28px; right:-28px;}
.block-row.reverse .block-photo img.accent{right:auto; left:-28px;}
.block-copy h2{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(26px,4vw,36px); color:var(--sage-dark); line-height:1.2; margin:8px 0 16px;}
.block-copy p{font-size:16px; line-height:1.75; margin-bottom:22px;}

.info-list{list-style:none; margin-bottom:8px;}
.info-list li{padding:12px 0; border-bottom:0.5px solid rgba(0,0,0,0.1);}
.info-list li .lbl{display:block; font-family:'Jost', sans-serif; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--gold-dark); margin-bottom:4px;}
.info-list li .val{font-size:16px;}
.swatch-dots{display:inline-flex; gap:6px; vertical-align:middle; margin-left:8px;}
.swatch-dots span{width:12px; height:12px; border-radius:50%; display:inline-block; border:1px solid rgba(0,0,0,0.1);}

.rsvp-teaser{max-width:1080px; margin:0 auto; padding:10vh 6vw; display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center;}
@media (max-width:760px){ .rsvp-teaser{grid-template-columns:1fr;} }
.rsvp-teaser img{width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:6px; display:block;}
.rsvp-teaser .rt-copy h2{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(26px,4vw,34px); color:var(--sage-dark); margin:8px 0 16px;}
.rsvp-teaser form{max-width:360px; margin:0; display:flex; flex-direction:column; gap:12px;}

.news-row{max-width:1080px; margin:0 auto; padding:10vh 6vw; display:grid; grid-template-columns:1fr 1.1fr; gap:48px; align-items:center;}
@media (max-width:760px){ .news-row{grid-template-columns:1fr;} }
.news-row img{width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:6px; display:block;}
.news-item{display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:20px 0; border-bottom:0.5px solid rgba(0,0,0,0.1); text-decoration:none; color:var(--ink);}
.news-item:first-child{padding-top:0;}
.news-item h3{font-family:'Cormorant Garamond', serif; font-weight:500; font-size:22px; color:var(--sage-deep); margin-bottom:4px;}
.news-item p{font-size:14px; opacity:0.8;}
.news-item .arrow{font-size:18px; color:var(--gold-dark); flex-shrink:0;}

.closing-band-split{background:var(--sage-deep); color:var(--ivory); padding:10vh 6vw;}
.closing-band-split .cb-inner{max-width:1080px; margin:0 auto; display:grid; grid-template-columns:1.3fr 1fr; gap:40px; align-items:center;}
@media (max-width:700px){ .closing-band-split .cb-inner{grid-template-columns:1fr; text-align:center;} }
.closing-band-split h2{font-family:'Cormorant Garamond', serif; font-weight:400; font-size:clamp(26px,4.5vw,38px); line-height:1.3;}
.closing-band-split .cb-info p{font-family:'Jost', sans-serif; font-size:13px; letter-spacing:0.08em; color:#DCE6D0; margin-bottom:6px;}

/* ===== Mobile hardening ===== */
@media (max-width:640px){
  .photo-wrap img{border-radius:24px; aspect-ratio:4/5;}
  .photo-wrap .vine{width:80px;}
  .photo-wrap .vine.pw-tl{top:-16px; left:-16px;}
  .photo-wrap .vine.pw-br{bottom:-16px; right:-16px;}

  .block-photo img.accent{width:38%; bottom:-14px; right:-14px; border-width:4px;}
  .block-row.reverse .block-photo img.accent{left:-14px;}

  .gallery{grid-template-columns:repeat(2,1fr);}
  .gallery .tile{margin-top:0 !important;}

  .countdown-big{gap:14px;}
  .countdown-big .unit{min-width:64px; padding:0;}
  .countdown-big .num{font-size:38px;}

  .info-list li .val{font-size:15px;}
  .swatch-dots{margin-left:0; margin-top:6px; display:flex;}

  .rsvp-teaser, .news-row{gap:28px;}
  .news-item{flex-wrap:wrap;}
